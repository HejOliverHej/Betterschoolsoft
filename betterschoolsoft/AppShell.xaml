<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="betterschoolsoft.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:View="clr-namespace:betterschoolsoft.View"
    Title="betterschoolsoft">


    <ShellContent
        Route="LoginView"
        ContentTemplate="{DataTemplate View:LoginView}" />

    <ShellContent
        Route="SignupView"
        ContentTemplate="{DataTemplate View:Singinview}" />

    <TabBar Route="StudentSection">
        <ShellContent
            Title="Dashboard"
            Icon="home.png"
            ContentTemplate="{DataTemplate View:StudentDashboardView}"
            Route="StudentDashboardView" />

        <ShellContent
            Title="Schema"
            Icon="calendar.png"
            ContentTemplate="{DataTemplate View:StudentScheduleView}"
            Route="StudentScheduleView" />
    </TabBar>

    <TabBar Route="TeacherSection">
        <ShellContent
            Title="Dashboard"
            Icon="teacher.png"
            ContentTemplate="{DataTemplate View:TeacherDashboardView}"
            Route="TeacherDashboardView" />

        <ShellContent
            Title="Klasser"
            Icon="class.png"
            ContentTemplate="{DataTemplate View:ClassManagementTeacherView}"
            Route="ClassManagementTeacherView" />

        <ShellContent
            Title="Schemaeditor"
            Icon="edit.png"
            ContentTemplate="{DataTemplate View:ScheduleEditorTeacherView}"
            Route="ScheduleEditorTeacherView" />
    </TabBar>

</Shell>

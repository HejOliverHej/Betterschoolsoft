<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="betterschoolsoft.View.AddTeacherPopup"
             Title="Lägg till lärare">

    <Frame Padding="20"
           BackgroundColor="White"
           CornerRadius="10"
           VerticalOptions="Center"
           HorizontalOptions="Center"
           WidthRequest="300">

        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Lägg till lärare" FontSize="24" />

            <Entry Placeholder="Username" TextColor="Black" Text="{Binding TeacherName}" />

            <Entry Placeholder="Lösenord"
               IsPassword="True"
               Text="{Binding Password}" TextColor="Black" />

            <Button Text="Lägg till" Command="{Binding AddCommand}" />
            <Button Text="Avbryt" Command="{Binding CancelCommand}" />

        </VerticalStackLayout>

    </Frame>
</ContentPage>

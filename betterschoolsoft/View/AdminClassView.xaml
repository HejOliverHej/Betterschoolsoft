<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="betterschoolsoft.View.AdminClassView"
             Title="AdminClassView">
    <VerticalStackLayout Padding="20">

        <Label Text="Klasser" FontSize="24" />

        <CollectionView ItemsSource="{Binding Classes}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="10" Margin="5">
                        <VerticalStackLayout>
                            <Label Text="{Binding Name}" FontSize="20" />
                            <Label Text="{Binding ClassTeacher.Username}" FontSize="14" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Text="Skapa ny klass" Command="{Binding CreateClassCommand}" />

    </VerticalStackLayout>
</ContentPage>
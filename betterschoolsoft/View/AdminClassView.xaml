<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="betterschoolsoft.View.AdminClassView"
             xmlns:vm="clr-namespace:betterschoolsoft.ViewModel"

             Title="AdminClassView">

    <ScrollView>
        <VerticalStackLayout Padding="20">

        <Label Text="Klasser" FontSize="24" />

        <CollectionView ItemsSource="{Binding Classes}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="10" Margin="5" BorderColor="LightGray" CornerRadius="10">
                        <VerticalStackLayout Spacing="5">

                            <Label Text="{Binding Name}" FontSize="20" FontAttributes="Bold" />
                            <Label Text="Klasslärare:" FontSize="14" />
                            <Label Text="{Binding ClassTeacher.Username}" FontSize="14" />

                            <HorizontalStackLayout Spacing="10" Margin="0,10,0,0">

                                <Button Text="Visa"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminClassViewModel}}, Path=OpenClassDetailsCommand}"
                                CommandParameter="{Binding .}"
                                FontSize="12" />

                            </HorizontalStackLayout>

                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>


        <Button Text="Skapa ny klass" Command="{Binding OpenCreateClassPopupCommand}" />

    </VerticalStackLayout>


    </ScrollView>
</ContentPage>
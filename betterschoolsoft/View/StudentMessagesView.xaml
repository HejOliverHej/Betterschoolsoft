<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="betterschoolsoft.View.StudentMessagesView"
             Title="StudentMessagesView">


    <ContentPage.Content>

        <CollectionView ItemsSource="{Binding Messages}"
                        Margin="10">

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Frame Padding="15"
                           Margin="0,5"
                           BorderColor="#cccccc"
                           CornerRadius="10"
                           HasShadow="True">

                        <VerticalStackLayout Spacing="5">

                            <Label Text="{Binding Title}"
                                   FontAttributes="Bold"
                                   FontSize="18" />

                           
                            <Label Text="{Binding Body}"
                                   FontSize="14"
                                   TextColor="White" />

                            <Label Text="{Binding SentAt, StringFormat='Skickat: {0:yyyy-MM-dd HH:mm}'}"
                                   FontSize="12"
                                   TextColor="Gray" />

                        </VerticalStackLayout>

                    </Frame>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </ContentPage.Content>


</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="betterschoolsoft.View.AdminMessageView"
             Title="AdminMessageView">
    
    
    <VerticalStackLayout Padding="20" Spacing="20">

        <Entry Placeholder="Titel" Text="{Binding Title}" />

        <Editor Placeholder="Meddelande" HeightRequest="200" Text="{Binding Body}" />

        <Picker Title="Välj mottagare"
            ItemsSource="{Binding RecipientGroups}"
            SelectedItem="{Binding SelectedRecipientGroup}" />

        <Button Text="Skicka"
            BackgroundColor="LightGreen"
            Command="{Binding SendCommand}" />

    </VerticalStackLayout>

</ContentPage>
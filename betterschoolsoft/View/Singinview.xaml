<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="betterschoolsoft.View.Singinview"
             Title="Singinview"
             >


    <VerticalStackLayout VerticalOptions="Center"
                         HorizontalOptions="Center"
                         Spacing="10"
                         WidthRequest="250">

        <Label Text="Skapa konto" FontSize="20"/>

        <Entry Placeholder="Username"
               Text="{Binding Username}" />

        <Entry Placeholder="Password"
               IsPassword="True"
               Text="{Binding Password}" />

        <Entry Placeholder="Confirm Password"
               IsPassword="True"
               Text="{Binding ConfirmPassword}" />

        <Label Text="Välj roll:" />

        <RadioButton Content="Student"
                     IsChecked="{Binding IsStudent}" />

        <RadioButton Content="Teacher"
                     IsChecked="{Binding IsTeacher}" />

        <Button Text="Spara konto"
                Command="{Binding SignUpCommand}" />

        <Label Text="{Binding Message}" TextColor="Red"/>

    </VerticalStackLayout>
    
</ContentPage>
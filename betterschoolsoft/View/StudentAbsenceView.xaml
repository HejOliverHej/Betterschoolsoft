<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="betterschoolsoft.View.StudentAbsenceView"
             Title="StudentAbsenceView">
    <VerticalStackLayout Padding="20">

        <Label Text="Frånvarolista"
               FontSize="24"
               FontAttributes="Bold"
               HorizontalOptions="Center" />

        <CollectionView ItemsSource="{Binding Absences}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,10"
                           Padding="15" >

                        <VerticalStackLayout>

                            <Label Text="{Binding Date, StringFormat='Datum: {0:yyyy-MM-dd}'}"
                                   FontSize="18"
                                   FontAttributes="Bold" />

                            <Label Text="{Binding Lessonid, StringFormat='Lektion ID: {0}'}"
                                   FontSize="14" />

                            <Label Text="{Binding Studentid, StringFormat='Elev ID: {0}'}"
                                   FontSize="14" />
                            <Label Text="{Binding Amount, StringFormat='Hur länge: {0} min'}"
                                 FontSize="14" />

                        </VerticalStackLayout>

                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
        
</ContentPage>